+/* ================================================================
+   STUDENT CHROME REIMAGINED (UI only) — top bar + top-right menu
+   toggle replacing the bottom tab bar / desktop left sidebar.
+   The nav keeps id="tabbar" and its items keep .tab/data-t, so go()'s
+   show/hide + active-highlight logic and the Free UTME shell rules
+   keep working unchanged; only the presentation moved.
+   ================================================================ */
+.tabbar.appbar{position:absolute;top:0;left:0;right:0;bottom:auto;height:60px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:0 14px;z-index:70;box-shadow:0 4px 18px rgba(17,24,39,.06)}
+.tabbar.appbar .app-brand{display:flex;flex-direction:row;align-items:center;justify-content:flex-start;gap:10px;border:none;background:none;cursor:pointer;font-family:var(--font);flex:0 1 auto;min-width:0;padding:0;color:var(--ink);font-size:14px}
+.tabbar.appbar .app-brand .bmk{width:36px;height:36px;border-radius:11px;background:var(--red);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
+.tabbar.appbar .app-brand .bt{font-size:14.5px;font-weight:900;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink)}
+.tabbar.appbar .app-sp{flex:1 1 auto}
+.tabbar.appbar .app-bell{width:42px;height:42px;border-radius:50%;border:1.5px solid var(--line);background:#fff;color:var(--slate);cursor:pointer;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
+.tabbar.appbar .menu-toggle{width:46px;height:42px;border-radius:13px;border:none;background:var(--red);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex:0 0 auto;box-shadow:0 8px 18px rgba(220,38,38,.32)}
+.phone.hub-chrome .screens{top:60px}
+.menu-scrim{position:fixed;inset:60px 0 0 0;background:rgba(15,17,20,.45);display:none;z-index:71}
+.menu-scrim.show{display:block}
+.menu-panel{position:absolute;top:66px;right:12px;width:min(320px,calc(100vw - 24px));max-height:calc(100dvh - 130px);overflow-y:auto;background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 30px 60px rgba(17,24,39,.25);padding:10px;z-index:72;display:none}
+.menu-panel.show{display:block}
+.mgroup{border-bottom:1px solid var(--line)}
+.mgroup:last-of-type{border-bottom:none}
+.mg-head{width:100%;display:flex;align-items:center;justify-content:space-between;border:none;background:none;cursor:pointer;font-family:var(--font);font-size:13px;font-weight:900;color:var(--ink);padding:13px 10px;letter-spacing:.01em}
+.mg-chev{color:var(--gray);transition:transform .18s ease}
+.mgroup.open .mg-chev{transform:rotate(180deg)}
+.mg-body{display:none;padding:0 4px 8px}
+.mgroup.open .mg-body{display:block}
+.tabbar.appbar .tab.mi{display:flex;flex-direction:row;align-items:center;justify-content:flex-start;gap:13px;width:100%;padding:11px 10px;border:none;background:none;border-radius:13px;cursor:pointer;font-family:var(--font);font-size:14px;font-weight:700;color:var(--slate);flex:0 0 auto}
+.tabbar.appbar .tab.mi .icon{width:21px;height:21px;flex:0 0 auto}
+.tabbar.appbar .tab.mi:hover{background:#F8F9FB}
+.tabbar.appbar .tab.mi.on{color:var(--red-deep);background:#FEECEC}
+.mfoot{border-top:1px solid var(--line);margin-top:6px;padding-top:6px}
+.mfoot .mi.logout{display:flex;flex-direction:row;align-items:center;gap:13px;width:100%;padding:11px 10px;border:none;background:none;border-radius:13px;cursor:pointer;font-family:var(--font);font-size:14px;font-weight:700;color:var(--red)}
+.mfoot .mi.logout .icon{width:21px;height:21px}
+/* Home study-window warning banner (replaces the old focus card) */
+.sw-banner{margin:14px 16px 0;position:relative;z-index:5;background:#FFFBEB;border:1.5px solid #F59E0B;border-radius:16px;padding:12px 14px;display:flex;align-items:center;gap:12px;color:#92400E}
+.sw-banner .icon{width:22px;height:22px;flex:0 0 auto}
+.sw-banner .sw-txt{flex:1 1 auto;display:flex;flex-direction:column;line-height:1.35}
+.sw-banner .sw-txt b{font-size:13.5px}
+.sw-banner .sw-txt span{font-size:11.5px;font-weight:700;opacity:.75}
+.sw-banner .sw-x{border:none;background:none;font-size:20px;line-height:1;color:#92400E;cursor:pointer;padding:4px 6px}
+/* Study CBT hub + instructions */
+.sc-mode{display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:#fff;border:1.5px solid var(--line);border-radius:20px;padding:16px;margin-bottom:12px;cursor:pointer;font-family:var(--font);box-shadow:var(--sh-sm)}
+.sc-mode .sc-ic{width:48px;height:48px;border-radius:15px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
+.sc-mode .sc-ic .icon{width:24px;height:24px}
+.sc-mode .sc-tx{flex:1 1 auto;display:flex;flex-direction:column;gap:2px;min-width:0}
+.sc-mode .sc-tx b{font-size:15.5px;color:var(--ink)}
+.sc-mode .sc-tx s{text-decoration:none;font-size:12.5px;color:var(--gray);font-weight:600;line-height:1.4}
+.sc-mode .sc-go{font-size:12.5px;font-weight:900;color:var(--red);white-space:nowrap}
+.scg-pill{display:inline-block;background:var(--red);color:#fff;font-size:11px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;padding:6px 12px;border-radius:999px}
+.scg-pill.alt{background:#fff;color:var(--red);border:1.5px solid var(--red)}
+.scg-rules{margin:14px 0 4px;padding-left:22px;line-height:1.55;font-size:14px;color:var(--slate)}
+.scg-rules li{margin-bottom:9px}
+.scg-rules li::marker{color:var(--red);font-weight:900}
+/* Practice palette: enclosed panel, collapsible, brand red = answered */
+.prac-pal-toggle{border:1.5px solid var(--red);background:#fff;color:var(--red);border-radius:999px;padding:6px 14px;font-family:var(--font);font-size:12px;font-weight:900;cursor:pointer}
+#practice .prac-pal.ans{background:var(--red);border-color:var(--red);color:#fff}
+#practice .prac-pal.ans.cur{background:var(--red);color:#fff;border-color:var(--red);box-shadow:0 0 0 3px rgba(220,38,38,.35)}
+#practice .prac-pal-legend .lg.ans{background:var(--red);border-color:var(--red)}
+/* Exam room: G.O.C white-and-red (Practice/CBT + JAMB candidate chrome) */
+.cbt-top{background:var(--red);color:#fff}
+#cbt .timer{background:#fff;color:var(--red);padding:8px 14px;border-radius:999px;box-shadow:0 6px 14px rgba(0,0,0,.18)}
+#cbt.jamb-mode .cbt-candidate{background:#fff;color:var(--ink);border-bottom:1.5px solid var(--line);border-top:none}
+#cbt.jamb-mode .cc-id{color:var(--gray)}
+#cbt.jamb-mode .cc-paper{color:var(--gray)}
+#cbt.jamb-mode .cbt-side{background:#fff}
+#cbt.jamb-mode .cbt-side-legend .lg.ans{background:var(--red);border-color:var(--red)}
+#cbt .qn.ans{background:var(--red);border-color:var(--red)}
+#cbt .qn.cur.ans{color:#fff}
+@media (min-width:900px){
+  /* Desktop: the top bar spans the window; content uses the full width
+     (the 256px sidebar offset is gone). */
+  .phone:not(.is-login) .screens{left:0}
+  .menu-panel{right:18px}
+  #home .wrap{max-width:880px}
+}
