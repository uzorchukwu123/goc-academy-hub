# G.O.C Academy Hub — environment template (PLACEHOLDERS ONLY).
#
# Never commit a real .env. This file contains no working credential.
# See APPWRITE-ENVIRONMENT.md for which variable belongs to which target.
#
# Existing OneBit variable names are reused verbatim so the same values can be
# pasted into Appwrite Function variables without renaming.

# ── Shared: existing Appwrite project (REUSE, never create a second project) ──
# Read these from your existing OneBit environment or the Appwrite Console.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<existing-project-id>
APPWRITE_API_KEY=<existing-server-api-key>

# Existing identifiers. These defaults already match the live project; only set
# them if your deployment overrides them today.
GOC_DATABASE_ID=goc_academy
GOC_BUCKET_ID=goc-data
GOC_BACKUP_FILE_ID=academy-data-json

# ── OneBit (Node.js server) — unchanged behaviour ─────────────────────────────
NODE_ENV=production
GOC_TRUST_PROXY=1
GOC_NO_DEMO_SEED=1
GOC_DATA_DIR=/absolute/path/to/persistent/volume
GOC_FREE_2027=1
GOC_FOUNDER_PW=<strong-private-password>
GOC_ACADDIR_PW=<strong-private-password>
GOC_PASSCODE=<private-console-passcode>

# Leave GOC_APPWRITE_OFF UNSET for normal OneBit operation.
# GOC_APPWRITE_OFF=1

# ── Appwrite Sites (static frontend build) ────────────────────────────────────
# PUBLIC by design. Baked into the build; must never contain a secret.
# Must be an absolute http(s) URL ending in /api, with no trailing slash.
# Leave UNSET for a OneBit build so the relative 'api' base is preserved.
# GOC_API_BASE=https://<your-function>.appwrite.global/api

# ── Appwrite Functions (goc-api) ──────────────────────────────────────────────
# Exact Site origins allowed to call the API. Comma-separated. No wildcard.
GOC_ALLOWED_ORIGINS=https://<your-site>.appwrite.network
GOC_MAX_BODY_BYTES=1048576
GOC_SESSIONS_COLLECTION=sessions
GOC_STAFF_SESSION_MINUTES=480
GOC_STUDENT_SESSION_MINUTES=90

# Job ownership: exactly ONE environment may run the scheduled jobs, so running
# both deployments cannot double-send reminders. 'onebit' (default) or 'appwrite'.
GOC_JOB_OWNER=onebit

# ── Email / OTP (existing provider, unchanged) ────────────────────────────────
GOC_SMTP_HOST=<smtp-host>
GOC_SMTP_PORT=587
GOC_SMTP_USER=<smtp-user>
GOC_SMTP_PASS=<smtp-key>
GOC_SMTP_FROM=<authorised-sender>
# Must be at least 32 characters.
GOC_FREE_2027_OTP_SECRET=<at-least-32-random-characters>
